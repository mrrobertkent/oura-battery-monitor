    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row=$input.first()?.json;\nif(!row || row.ring_key!=='oura')throw new Error('Missing monitoring row in the Data Table');\nconst manual=$execution.mode==='test';\nconst next=Date.parse(row.next_poll_at||'');\nif(!manual&&Number.isFinite(next)&&next>Date.now())return [];\nreturn [{json:{...row,manual}}];"
      },
