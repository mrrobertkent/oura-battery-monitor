      "id": "f5cbde5f-c924-48a4-9fc4-59806c3338f2",
      "name": "Get Current Active Receipt",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Stateful evaluation from first-class n8n Data Table fields.\nconst s=$('Polling Gate').first().json;\nconst now=Date.now();\nconst rows=$('Get Oura Battery').first().json.data||[];\nconst latest=rows.length?rows.reduce((a,b)=>timeOf(a)>timeOf(b)?a:b):null;\nfunction timeOf(r){\n const iso=Date.parse(r.timestamp||'');\n const n=Number(r.producer_timestamp);\n if(Number.isFinite(n)&&n>1e12&&n<=now+300000&&n>1577836800000&&\n   (!Number.isFinite(iso)||Math.abs(n-iso)<86400000))return n;\n return iso;\n}\nfunction mins(p){if(p>40)return 480;if(p>30)return 360;if(p>20)return 240;if(p>10)return 120;if(p>7)return 60;if(p>5)return 30;return 15;}\nconst active=$input.first().json;\nconst hasActive=/^[A-Za-z0-9]{30}$/.test(String(active.receipt_id||''));\nconst out={...s,manual:undefined,has_active:hasActive,active_receipt:hasActive?active.receipt_id:null,\n alert_type:'none',action:'none',title:'Oura Ring',message:'',battery_status:'missing'};\nconst value=latest?.level;\nconst level=value==null?NaN:Number(value);\nconst sourceAt=latest?timeOf(latest):NaN;\nlet poll=60;\nif(Number.isFinite(level)&&level>=0&&level<=100&&Number.isFinite(sourceAt)){\n const age=(now-sourceAt)/60000, fresh=age>=-5&&age<=360;\n const charging=latest.charging===true, inCharger=latest.in_charger===true;\n const critical=level>0&&level<=5;\n out.battery_status=fresh?'fresh':'stale';\n poll=fresh?mins(level):Math.min(mins(level),60);\n out.battery_level=level;\n out.charging=charging;out.in_charger=inCharger;\n out.last_checked_at=new Date(now).toISOString();\n const priorSource=Date.parse(s.last_source_at||'');\n if(fresh&&(!Number.isFinite(priorSource)||sourceAt>priorSource)){\n   out.last_source_at=new Date(sourceAt).toISOString();\n   out.last_source_seen_at=new Date(now).toISOString();\n }\n if(fresh&&level>=15){\n   out.low_alert_sent=false;out.unresponsive_alert_sent=false;out.dead_alert_sent=false;\n   out.snoozed_until=new Date(0).toISOString();\n }\n if(fresh&&(charging||inCharger)){\n   // Charging cancels any outstanding Emergency retries.\n   if(hasActive)out.action='cancel';\n }else if(fresh&&!charging&&!inCharger){\n   const snoozed=Date.parse(s.snoozed_until||'')>now;\n   if(level===0&&s.dead_alert_sent!==true){\n     out.alert_type='dead';out.message='Battery dead (0%).';\n   }else if(!snoozed&&critical&&s.low_alert_sent!==true){\n     out.alert_type='low';out.message='Battery: '+level+'%. Charge now.';\n   }else if(!snoozed&&critical&&s.low_alert_sent===true&&s.unresponsive_alert_sent!==true&&\n     Number.isFinite(Date.parse(out.last_source_seen_at||''))&&\n     now-Date.parse(out.last_source_seen_at)>=150*60000){\n     out.alert_type='unresponsive';out.message='Unresponsive';\n   }\n   if(out.alert_type!=='none')out.action=hasActive?'cancel':'send';\n }\n}\nout.next_poll_at=new Date(now+poll*60000).toISOString();\nreturn [{json:out}];"
      },
