        "jsCode": "const receipt=$('Find Active Receipt').first().json;\nconst response=$input.first().json;\nif(Number(response.status)!==1)throw new Error('Pushover receipt status request failed');\nconst ack=Number(response.acknowledged)===1;\nconst expired=Number(response.expired)===1;\nconst state=ack?'acknowledged':expired?'expired':'active';\nconst at=Number(response.acknowledged_at)||0;\nreturn [{json:{receipt_id:receipt.receipt_id,status:state,\n  acknowledged_at:at>0?new Date(at*1000).toISOString():null,\n  resolved_at:state==='active'?null:new Date().toISOString(),\n  snoozed_until:ack&&at>0?new Date(at*1000+6*3600000).toISOString():null}}];"
      },
